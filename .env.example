CONTENTSTUDIO_DATA_DIR=./data
CONTENTSTUDIO_PORT=4311
# Remote providers and paid APIs are disabled by default.
CONTENTSTUDIO_ALLOW_REMOTE=false
CONTENTSTUDIO_ALLOW_PAID=false
# Optional local ComfyUI; not called unless a user explicitly queues a job.
CONTENTSTUDIO_COMFY_URL=http://127.0.0.1:8188
# Optional ComfyUI workflow file exported in API JSON format:
# CONTENTSTUDIO_IMAGE_WORKFLOW=C:\comfy\image-api.json
# CONTENTSTUDIO_IMAGE_BINDINGS_JSON={"prompt":{"nodeId":"6","input":"text"},"seed":{"nodeId":"3","input":"seed"},"width":{"nodeId":"5","input":"width"},"height":{"nodeId":"5","input":"height"}}
# Node IDs above are illustrative: use the actual exported ComfyUI API workflow.
# R2-05 never auto-downloads checkpoints or uses cloud fallback.
# CONTENTSTUDIO_VIDEO_WORKFLOW=C:\comfy\wan-api.json
# CONTENTSTUDIO_VIDEO_BINDINGS_JSON={"prompt":{"nodeId":"6","input":"text"}}

# R1-07: Remote LLM is opt-in; NONE of these flags is a billing authorization.
# Gemini/Groq/OpenRouter are contacted only through hard-coded official HTTPS hosts.
CONTENTSTUDIO_REMOTE_LLM_CONSENT=0
# Comma-separated INTERNAL provider_models.id (not names) for accounts whose
# external provider billing settings have independently confirmed NO charges.
# An editable database label "free_unverified" is never sufficient on its own.
CONTENTSTUDIO_CONFIRMED_NO_BILLING_MODEL_IDS=
# Optional verified maximum per-invocation estimates in integer MICRO-USD.
# Example only: {"internal-model-id":150000} is $0.15, NOT an actual quote.
# Leave unset until independently verified. Paid also needs job approval via UI.
# CONTENTSTUDIO_VERIFIED_LLM_PRICE_CAPS_JSON={"internal-model-id":150000}

# R2-04 — Optional local TTS HTTP bridges; disabled if URL is omitted.
# Start/load the local model server separately. Literal 127.0.0.1 only.
# POST /synthesize returns binary WAV/MP3; GET /health returns HTTP 2xx.
# CONTENTSTUDIO_PIPER_TTS_URL=http://127.0.0.1:8111/synthesize
# CONTENTSTUDIO_PIPER_TTS_VOICE=vi_VN_piper
# CONTENTSTUDIO_PIPER_TTS_BODY_FORMAT=json
# CONTENTSTUDIO_VIENEU_TTS_URL=http://127.0.0.1:8112/synthesize
# CONTENTSTUDIO_VIENEU_TTS_VOICE=vi_VN_natural
# CONTENTSTUDIO_VIENEU_TTS_BODY_FORMAT=json
# Format `text` sends raw text/plain for compatible bridge servers.
# No remote TTS fallback and no paid service is implicitly enabled.

# R2-08: token holds for remote FREE LLM models with user-entered quota ceilings.
# Map INTERNAL model UUID -> conservative tokens per call (including output).
# When a configured quota ceiling exists and an estimate is missing, remote
# dispatch is BLOCKED. These estimates are NOT provider-verified entitlement.
# CONTENTSTUDIO_LLM_QUOTA_RESERVATIONS_JSON={"internal-model-id":1200}
